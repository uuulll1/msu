# systemd-юнит для gunicorn (/etc/systemd/system/msu-portal.service)
[Unit]
Description=MSU student portal (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/msu-portal
EnvironmentFile=/srv/msu-portal/.env
RuntimeDirectory=msu-portal
ExecStart=/srv/msu-portal/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 --timeout 120 --bind unix:/run/msu-portal/gunicorn.sock
Restart=on-failure

[Install]
WantedBy=multi-user.target
