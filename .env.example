# Скопируйте в .env и отредактируйте
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Для продакшена укажите домены с протоколом через запятую
DJANGO_CSRF_TRUSTED_ORIGINS=
# По умолчанию SQLite. Пример PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/msu_portal
DATABASE_URL=
# Каталог для загруженных файлов (на Render — путь к подключённому диску)
DJANGO_MEDIA_ROOT=
